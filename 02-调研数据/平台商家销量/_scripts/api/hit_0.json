  document.addEventListener('visibilitychange', () => {
    try {
      if (document.visibilityState === 'visible' && window.clickBeforeHydrateParams) {
        console.log('[debug] before hydrate params', window.clickBeforeHydrateParams);
        var cid = window.clickBeforeHydrateParams.cid;
        window.clickBeforeHydrateParams = null;

        var click_before_hydrate_params = {
          cid,
          search_id: window.searchId,
          enable_reload: 1,
        }
        if (window.hydrateEnd) {
          return;
        }
        if (window.Tea) {
          console.log('[debug] click before hydrate log', click_before_hydrate_params)
          window.Tea.beaconEvent('return_from_click_before_hydrate', click_before_hydrate_params);
        } else {
          console.log('[debug] click before hydrate in local storage', click_before_hydrate_params)
          localStorage.setItem('click_before_hydrate_log', JSON.stringify({click_before_hydrate_params}))
        }
        
      const currentUrl = new URL(window.location.href);
      const searchParams = currentUrl.searchParams;
      searchParams.set('reload_from', 'back_before_hydrate');
      currentUrl.search = searchParams.toString();
      window.history.replaceState(null, '', currentUrl.toString());
      window.location.reload();
    
      }
    } catch(e) {
      console.error('[debug] before hydrate log error', e.message);
    }
  })
</script><script nonce="ac9c2096c62d60ced8a0f6ee69533a61-argus">
            (function() {
              // 监听用户在吸水前的点击事件
              function __handleBeforeHydrateClick(e) {
                try {
                  if (window.hydrateEnd) {
                    // 已经吸水了，不需要再监听了，防止重复执行
                    document.removeEventListener('click', __handleBeforeHydrateClick);
                    return
                  }

                  var currentElement = e.target;
                  var cardName = null;
                  var rank = null;

                  while (currentElement && currentElement !== document.documentElement) {
                    if (!cardName && currentElement.hasAttribute('data-tag') &&
                        currentElement.getAttribute('data-tag') === 'lynx-card') {
                      cardName = currentElement.getAttribute('data-card-name');
                    }

                    if (currentElement.classList.contains('card-item')) {
                      rank = currentElement.getAttribute('data-rank');
                      break;
                    }

                    currentElement = currentElement.parentElement;
                  }
                  var params = {
                    card_type_name: cardName,
                    search_id: window.searchId,
                    rank: parseInt(rank, 10),
                    clk_time: performance.now(),
                  }
                  // 记录初始点击时机
                  window.__card_click_before_hydrate__ = params;

                  if (window.Tea) {
                    window.Tea.beaconEvent('card_click_before_hydrate', params);
                  } else {
                    localStorage.setItem('card_click_before_hydrate', JSON.stringify({params}))
                  }
                  // 移除监听
                  document.removeEventListener('click', __handleBeforeHydrateClick);
                } catch(err) {
                  console.error('Error processing click:', err);
                }
              }
              document.addEventListener('click', __handleBeforeHydrateClick);
            })()
